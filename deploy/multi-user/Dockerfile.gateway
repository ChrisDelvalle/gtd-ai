FROM caddy:2.11.6-alpine@sha256:d44355d3c2149dc580ce2cac735955d1c08d3d00882c30489c241aa51a5c10d9
# Drop vendor file capabilities so tunnel mode can use cap_drop ALL. Direct
# HTTPS ingress grants only NET_BIND_SERVICE explicitly in its runtime config.
RUN setcap -r /usr/bin/caddy
ENV XDG_DATA_HOME=/tmp XDG_CONFIG_HOME=/tmp
USER 1000:1000
