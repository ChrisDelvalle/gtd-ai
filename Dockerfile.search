FROM getmeili/meilisearch:v1.54.3@sha256:e68913ab7d6f5b159529e472cfd362ce3c741fafd3c127961b2142abbe41b3c9
# Match the application/secret owner while retaining an independently writable
# index volume. Docker initializes a new volume with this directory's ownership.
RUN mkdir -p /meili_data && chown 1000:1000 /meili_data
USER 1000:1000
